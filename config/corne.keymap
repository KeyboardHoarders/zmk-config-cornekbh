#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        // Euro sign: types U+20AC via WinCompose on Windows
        // (RALT+U then 20ac then RET). mod-morph with `&none` on shift
        // matches the original ZMK_UNICODE_SINGLE semantics.
        // Edit the `euro_sign_lower` macro below to retarget per OS:
        //   Windows:  &macro_press &kp RALT &kp U RELEASE  ...  &macro_tap &kp RET
        //   Linux:    &macro_tap &kp LS(LC(U))  ...  &macro_tap &kp SPACE
        //   macOS:    &macro_press &kp LALT  ...  &macro_release &kp LALT

        euro_sign: euro_sign {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&euro_sign_lower>, <&none>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        seq_1: seq_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N0 &kp N2 &kp N8 &kp N2 &kp N9 &kp LS(B) &kp R &kp U &kp N &kp I &kp N &kp H &kp O &kp N0 &kp N5 &kp ENTER>;
            label = "SEQ_1";
        };

        seq_2: seq_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N0 &kp N2 &kp N8 &kp N2 &kp N9 &kp LS(G) &kp A &kp E &kp L &kp N0 &kp N5 &kp ENTER>;
            label = "SEQ_2";
        };

        seq_3: seq_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp N2 &kp N6 &kp N0 &kp N5 &kp LS(G) &kp A &kp E &kp L &kp N2 &kp N7 &kp N0 &kp N4 &kp LS(L) &kp I &kp Z &kp STAR &kp ENTER>;
            label = "SEQ_3";
        };

        print_mac: print_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp NUMBER_4>;

            label = "PRINT_MAC";
        };

        rec_mac: rec_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp N5>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp N5>;

            label = "REC_MAC";
        };

        lock_mac: lock_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_CONTROL &kp Q>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp LEFT_CONTROL &kp Q>;

            label = "LOCK_MAC";
        };

        ctrl_c: ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp C>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp C>;

            label = "CTRL_C";
        };

        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp V>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp V>;

            label = "CTRL_V";
        };

        cmd_c: cmd_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp C>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp C>;

            label = "CMD_C";
        };

        cmd_v: cmd_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp V>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp V>;

            label = "CMD_V";
        };

        // Euro sign macro: types U+20AC via macOS Unicode Hex Input.
        // Requires: System Settings → Keyboard → Input Sources →
        //           "Unicode Hex Input" added and active when pressing the combo.
        // Sequence: hold LEFT_ALT, tap 2-0-A-C, release LEFT_ALT.

        euro_sign_lower: euro_sign_lower {
            compatible = "zmk,behavior-macro";
            wait-ms = <10>;
            tap-ms = <10>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LEFT_ALT &kp LEFT_SHIFT>;
        };

        cmd_x: cmd_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp X>,
                <&macro_release>,
                <&kp LEFT_COMMAND &kp X>;

            label = "CMD_X";
        };

        a_til: a_til {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A>;
            label = "A_TIL";
        };

        c_cedilha: c_cedilha {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp C>;
            label = "C_CEDILHA";
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        perc {
            bindings = <&kp PERCENT>;
            key-positions = <4 16>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 6>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 15>;
            layers = <0>;
        };

        pound {
            bindings = <&kp POUND>;
            key-positions = <17 5>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <2 14>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <34 33>;
            layers = <0>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <9 21>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <10 22>;
            layers = <0>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <7 19>;
            layers = <0>;
        };

        minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <8 20>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <30 18>;
            layers = <0>;
        };

        leftbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        rightbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 32>;
            layers = <0>;
        };

        para-less {
            bindings = <&paraless>;
            key-positions = <20 19>;
            layers = <0>;
        };

        para-great {
            bindings = <&paragreat>;
            key-positions = <20 21>;
            layers = <0>;
        };

        copy {
            bindings = <&cmd_c>;
            key-positions = <26 27>;
        };

        paste {
            bindings = <&cmd_v>;
            key-positions = <27 28>;
        };

        til {
            bindings = <&kp TILDE>;
            key-positions = <22 23>;
        };

        cut {
            bindings = <&cmd_x>;
            key-positions = <25 26>;
        };

        euro {
            bindings = <&euro_sign_lower>;
            key-positions = <15 27>;
        };

        a_til {
            bindings = <&a_til>;
            key-positions = <12 13>;
        };

        c_cedilha {
            bindings = <&c_cedilha>;
            key-positions = <24 27>;
        };
    };

    //

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp TAB    &kp Q               &kp W           &kp E               &kp R  &kp T        &kp Y      &kp U      &kp I                &kp O            &kp P                   &kp BACKSPACE
&kp LSHFT  &hm LEFT_CONTROL A  &hm LEFT_ALT S  &hm LEFT_COMMAND D  &kp F  &kp G        &kp H      &kp J      &hm RIGHT_COMMAND K  &hm RIGHT_ALT L  &hm RIGHT_CONTROL SEMI  &kp SQT
&kp LCTRL  &kp Z               &kp X           &kp C               &kp V  &kp B        &kp N      &kp M      &kp COMMA            &kp DOT          &kp FSLH                &kp RET
                                               &kp LGUI            &mo 1  &kp SPACE    &kp SPACE  &lt 2 TAB  &kp LEFT_ALT
            >;
        };

        NAV {
            display-name = "NavNum";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&trans      &trans  &trans    &trans        &trans           &trans           &trans      &hm AMPERSAND N7          &hm ASTERISK N8  &hm LEFT_PARENTHESIS N9  &hm RIGHT_PARENTHESIS N0  &trans
&caps_word  &trans  &trans    &kp UP_ARROW  &browsertab      &kp PAGE_UP      &kp N0      &hm DOLLAR N4             &hm PERCENT N5   &hm CARET N6             &trans                    &trans
&trans      &trans  &kp LEFT  &kp DOWN      &kp RIGHT_ARROW  &kp PAGE_DOWN    &kp PERIOD  &hm EXCLAMATION NUMBER_1  &hm AT N2        &hm HASH N3              &trans                    &trans
                              &kp LGUI      &trans           &kp SPACE        &kp RET     &mo 3                     &trans
            >;
        };

        SYM {
            display-name = "Symbols";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL  &kp AT          &kp HASH        &kp DLLR         &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RPAR  &trans
&trans  &trans    &trans          &kp UP_ARROW    &trans           &kp GRAVE    &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT              &kp BSLH  &trans
&trans  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TILDE    &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC              &kp PIPE  &trans
                                  &kp LGUI        &mo 3            &kp SPACE    &kp RET    &trans     &trans
            >;
        };

        ADJ {
            display-name = "System";
            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5            &kp F6      &kp F7  &kp F8  &kp F9  &kp F10      &trans
&trans  &kp F11       &kp F12       &trans        &trans        &studio_unlock    &trans      &trans  &trans  &trans  &trans       &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR  &trans  &trans  &trans  &bootloader  &trans
                                    &trans        &trans        &trans            &trans      &trans  &trans
            >;
        };

        EXTRA {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans          &trans          &trans           &msc SCRL_UP      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_DOWN    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &trans  &trans     &trans     &trans  &trans  &trans
                                &trans          &trans           &trans            &trans  &trans     &trans
            >;
        };

        FNKEY {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans
                        &trans  &trans  &trans    &trans  &trans   &trans
            >;

            label = "FnKeys";
        };

        MED {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp C_VOLUME_DOWN        &kp C_MUTE  &kp C_VOL_UP       &kp C_BRI_DN  &kp C_BRI_UP
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &hm C_REWIND C_PREVIOUS  &kp C_PP    &hm C_FF C_NEXT    &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp C_PREVIOUS           &trans      &kp LS(K_FORWARD)  &trans        &trans
                        &trans  &trans  &trans    &trans  &trans                   &trans
            >;

            label = "Media";
        };

        MAC {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &seq_1  &seq_2  &seq_3  &trans  &rec_mac  &print_mac
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &lock_mac
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Macros";
        };
    };
};
